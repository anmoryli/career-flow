# 复制为 .env 后按需修改；默认值仅适用于本机 docker compose。
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-only-secret-key-0123456789abcdef
SESSION_ENCRYPTION_KEY=local-only-session-key-fedcba9876543210
ADMIN_CONFIG_KEY=local-only-admin-key-0123456789abcdef

MYSQL_PASSWORD=careerflow-local
MYSQL_ROOT_PASSWORD=root-local

APP_ENV=development
COOKIE_SECURE=false
MOCK_PAYMENT_ENABLED=false

# AI 默认关闭；打开前请确认供应商与费用授权。
AI_ENABLED=false
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
